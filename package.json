{
  "name": "scopeguard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc src/cli.ts src/mcp.ts --outDir dist --moduleResolution node --target ES2020 --module ESNext",
    "preview": "vite preview",
    "test": "vitest run",
    "audit": "tsx src/cli.ts",
    "mcp": "node dist/mcp.js"
  },
  "bin": {
    "scopeguard": "./dist/cli.js",
    "scopeguard-mcp": "./dist/mcp.js"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7"
  }
}
